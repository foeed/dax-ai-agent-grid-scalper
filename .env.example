# =============================================================
# Trend Scalper AI Bot — Environment Configuration
# Copy to .env and customize before trading live
# =============================================================

# --- Mode ---
TRADING_MODE=paper          # paper | live | bridge
DRY_RUN=true                # true = no real orders (SAFE)

# --- Symbol & Timeframe ---
SYMBOL=XAUUSD               # XAUUSD, SOLUSD, EURUSD, BTCUSD, etc.
TIMEFRAME=M1                # M1 | M5 | M15 | H1 | H4
BARS=300                    # number of bars to fetch
POLL_SECONDS=20             # seconds between trading cycles

# --- Data ---
DATA_CSV_PATH=              # optional CSV file for paper backtesting

# --- Strategy Parameters ---
EMA_FAST=8
EMA_SLOW=21
EMA_TREND=55
ATR_PERIOD=14
RSI_PERIOD=14
SL_ATR_MULTIPLIER=1.3
TP_ATR_MULTIPLIER=1.8
MIN_STOP_POINTS=80          # minimum stop distance in points
MIN_SIGNAL_CONFIDENCE=0.62  # 0-1, minimum signal confidence to trade

# --- Position Sizing ---
# Leave FIXED_LOT empty to use risk-based sizing (recommended)
FIXED_LOT=
MIN_LOT=0.01
MAX_LOT=0.10
RISK_PERCENT=0.25           # % of equity to risk per trade

# --- Risk Management ---
MAX_SPREAD_POINTS=35        # absolute spread cap (set 0 to disable)
MAX_POSITIONS=1             # max concurrent positions
MAX_TRADES_PER_DAY=8        # max trades per calendar day
COOLDOWN_SECONDS=180        # minimum seconds between trades
DAILY_LOSS_LIMIT_PERCENT=2.0 # stop trading if equity drops this % from start
MAX_SESSION_DRAWDOWN_PERCENT=5.0 # stop if equity drops this % from session peak
MAX_CONSECUTIVE_LOSSES=4    # pause after N consecutive losses
TRAILING_STOP_ATR_MULTIPLIER=0.5 # trailing stop ATR multiplier (0 = disabled)

# --- Order Execution ---
MAGIC_NUMBER=260618         # unique ID for this bot's orders
DEVIATION_POINTS=20         # max allowed slippage in points
ORDER_COMMENT=trend-scalper-ai

# --- LLM / DeepSeek (optional) ---
USE_LLM=false
DEEPSEEK_API_KEY=           # required if USE_LLM=true
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_MIN_SCORE=0.65          # minimum LLM approval score (0-1)
LLM_TIMEOUT_SECONDS=8       # timeout for LLM API calls
LLM_FAIL_CLOSED=true        # block trade if LLM fails (true=safe)

# --- Bridge Mode (Docker bot -> Windows MT5) ---
BRIDGE_URL=http://host.docker.internal:8765
BRIDGE_PASSWORD=Daxx777     # CHANGE in production
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765

# --- Signal Service (MT5 EA -> Docker signal service) ---
SIGNAL_HOST=127.0.0.1       # bind to localhost only for security
SIGNAL_PORT=8766
SIGNAL_PASSWORD=Daxx777     # CHANGE in production

# --- MT5 Login (live mode only) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# --- Storage ---
STATE_PATH=data/bot_state.json
EVENT_LOG_PATH=data/trade_events.jsonl
DASHBOARD_SETTINGS_PATH=data/dashboard_settings.json
DASHBOARD_EVENTS_LIMIT=100
LOG_LEVEL=INFO
